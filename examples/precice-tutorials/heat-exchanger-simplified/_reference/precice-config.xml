<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink format="---[precice] %ColorizedSeverity% %Message%" />
  </log>

  <data:scalar name="Temperature-Top" />
  <data:scalar name="Heat-Flux-Top" />
  <data:scalar name="Temperature-Bottom" />
  <data:scalar name="Heat-Flux-Bottom" />

  <mesh name="FluidTop-Mesh" dimensions="2">
    <use-data name="Temperature-Top" />
    <use-data name="Heat-Flux-Top" />
  </mesh>

  <mesh name="Solid-FluidTop-Surface-Mesh" dimensions="2">
    <use-data name="Heat-Flux-Top" />
  </mesh>

  <mesh name="Solid-FluidTop-Volume-Mesh" dimensions="2">
    <use-data name="Temperature-Top" />
  </mesh>

  <mesh name="FluidBottom-Mesh" dimensions="2">
    <use-data name="Temperature-Bottom" />
    <use-data name="Heat-Flux-Bottom" />
  </mesh>

  <mesh name="Solid-FluidBottom-Surface-Mesh" dimensions="2">
    <use-data name="Heat-Flux-Bottom" />
  </mesh>

  <mesh name="Solid-FluidBottom-Volume-Mesh" dimensions="2">
    <use-data name="Temperature-Bottom" />
  </mesh>

  <participant name="FluidTop">
    <provide-mesh name="FluidTop-Mesh" />
    <receive-mesh name="Solid-FluidTop-Surface-Mesh" from="Solid" />
    <read-data name="Heat-Flux-Top" mesh="FluidTop-Mesh" />
    <write-data name="Temperature-Top" mesh="FluidTop-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Solid-FluidTop-Surface-Mesh"
      to="FluidTop-Mesh"
      constraint="consistent" />
  </participant>

  <participant name="FluidBottom">
    <provide-mesh name="FluidBottom-Mesh" />
    <receive-mesh name="Solid-FluidBottom-Surface-Mesh" from="Solid" />
    <read-data name="Heat-Flux-Bottom" mesh="FluidBottom-Mesh" />
    <write-data name="Temperature-Bottom" mesh="FluidBottom-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Solid-FluidBottom-Surface-Mesh"
      to="FluidBottom-Mesh"
      constraint="consistent" />
  </participant>

  <participant name="Solid">
    <provide-mesh name="Solid-FluidTop-Surface-Mesh" />
    <provide-mesh name="Solid-FluidTop-Volume-Mesh" />
    <provide-mesh name="Solid-FluidBottom-Surface-Mesh" />
    <provide-mesh name="Solid-FluidBottom-Volume-Mesh" />
    <receive-mesh name="FluidTop-Mesh" from="FluidTop" />
    <receive-mesh name="FluidBottom-Mesh" from="FluidBottom" />
    <read-data name="Temperature-Top" mesh="Solid-FluidTop-Volume-Mesh" />
    <read-data name="Temperature-Bottom" mesh="Solid-FluidBottom-Volume-Mesh" />
    <write-data name="Heat-Flux-Top" mesh="Solid-FluidTop-Surface-Mesh" />
    <write-data name="Heat-Flux-Bottom" mesh="Solid-FluidBottom-Surface-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="FluidTop-Mesh"
      to="Solid-FluidTop-Volume-Mesh"
      constraint="consistent" />
    <mapping:nearest-neighbor
      direction="read"
      from="FluidBottom-Mesh"
      to="Solid-FluidBottom-Volume-Mesh"
      constraint="consistent" />
  </participant>

  <m2n:sockets acceptor="Solid" connector="FluidTop" exchange-directory=".." />
  <m2n:sockets acceptor="Solid" connector="FluidBottom" exchange-directory=".." />

  <coupling-scheme:multi>
    <participant name="FluidTop" />
    <participant name="FluidBottom" />
    <participant name="Solid" control="yes" />
    <exchange data="Temperature-Top" mesh="FluidTop-Mesh" from="FluidTop" to="Solid" />
    <exchange data="Heat-Flux-Top" mesh="Solid-FluidTop-Surface-Mesh" from="Solid" to="FluidTop" />
    <exchange data="Temperature-Bottom" mesh="FluidBottom-Mesh" from="FluidBottom" to="Solid" />
    <exchange
      data="Heat-Flux-Bottom"
      mesh="Solid-FluidBottom-Surface-Mesh"
      from="Solid"
      to="FluidBottom" />
    <time-window-size value="0.1" />
    <max-time-windows value="10" />
    <relative-convergence-measure data="Temperature-Top" mesh="FluidTop-Mesh" limit="0.1" />
    <relative-convergence-measure
      data="Heat-Flux-Top"
      mesh="Solid-FluidTop-Surface-Mesh"
      limit="0.1" />
    <relative-convergence-measure data="Temperature-Bottom" mesh="FluidBottom-Mesh" limit="0.1" />
    <relative-convergence-measure
      data="Heat-Flux-Bottom"
      mesh="Solid-FluidBottom-Surface-Mesh"
      limit="0.1" />
    <acceleration:IQN-ILS>
      <data name="Temperature-Top" mesh="FluidTop-Mesh" />
      <data name="Heat-Flux-Top" mesh="Solid-FluidTop-Surface-Mesh" />
      <data name="Temperature-Bottom" mesh="FluidBottom-Mesh" />
      <data name="Heat-Flux-Bottom" mesh="Solid-FluidBottom-Surface-Mesh" />
    </acceleration:IQN-ILS>
  </coupling-scheme:multi>
</precice-configuration>
