<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink format="---[precice] %ColorizedSeverity% %Message%" />
  </log>

  <data:vector name="Stress" />
  <data:vector name="Displacement" />

  <mesh name="Fluid-Volume-Mesh" dimensions="2">
    <use-data name="Stress" />
  </mesh>

  <mesh name="Fluid-Surface-Mesh" dimensions="2">
    <use-data name="Displacement" />
  </mesh>

  <mesh name="Solid-Mesh" dimensions="2">
    <use-data name="Stress" />
    <use-data name="Displacement" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-Volume-Mesh" />
    <provide-mesh name="Fluid-Surface-Mesh" />
    <receive-mesh name="Solid-Mesh" from="Solid" />
    <read-data name="Displacement" mesh="Fluid-Surface-Mesh" />
    <write-data name="Stress" mesh="Fluid-Volume-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Solid-Mesh"
      to="Fluid-Surface-Mesh"
      constraint="consistent" />
  </participant>

  <participant name="Solid">
    <provide-mesh name="Solid-Mesh" />
    <receive-mesh name="Fluid-Volume-Mesh" from="Fluid" />
    <read-data name="Stress" mesh="Solid-Mesh" />
    <write-data name="Displacement" mesh="Solid-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid-Volume-Mesh"
      to="Solid-Mesh"
      constraint="consistent" />
  </participant>

  <m2n:sockets acceptor="Fluid" connector="Solid" exchange-directory=".." />

  <coupling-scheme:parallel-implicit>
    <participants first="Fluid" second="Solid" />
    <exchange data="Stress" mesh="Fluid-Volume-Mesh" from="Fluid" to="Solid" />
    <exchange data="Displacement" mesh="Solid-Mesh" from="Solid" to="Fluid" />
    <time-window-size value="0.1" />
    <max-time-windows value="10" />
    <relative-convergence-measure data="Stress" mesh="Fluid-Volume-Mesh" limit="0.1" />
    <relative-convergence-measure data="Displacement" mesh="Solid-Mesh" limit="0.1" />
    <acceleration:IQN-ILS>
      <data name="Stress" mesh="Fluid-Volume-Mesh" />
      <data name="Displacement" mesh="Solid-Mesh" />
    </acceleration:IQN-ILS>
  </coupling-scheme:parallel-implicit>
</precice-configuration>
