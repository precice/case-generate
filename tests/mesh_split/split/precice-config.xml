<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink format="---[precice] %ColorizedSeverity% %Message%" />
  </log>

  <data:vector name="Forces" />
  <data:scalar name="Temperature" />
  <data:vector name="Displacements" />

  <mesh name="Fluid-SolidA-Extensive-Mesh" dimensions="3">
    <use-data name="Forces" />
  </mesh>

  <mesh name="Fluid-SolidA-Intensive-Mesh" dimensions="3">
    <use-data name="Temperature" />
    <use-data name="Displacements" />
  </mesh>

  <mesh name="SolidA-Extensive-Mesh" dimensions="3">
    <use-data name="Forces" />
  </mesh>

  <mesh name="SolidA-Intensive-Mesh" dimensions="3">
    <use-data name="Temperature" />
    <use-data name="Displacements" />
  </mesh>

  <mesh name="Fluid-SolidB-Mesh" dimensions="3">
    <use-data name="Forces" />
    <use-data name="Displacements" />
  </mesh>

  <mesh name="SolidB-Mesh" dimensions="3">
    <use-data name="Forces" />
    <use-data name="Displacements" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-SolidA-Extensive-Mesh" />
    <provide-mesh name="Fluid-SolidA-Intensive-Mesh" />
    <provide-mesh name="Fluid-SolidB-Mesh" />
    <receive-mesh name="SolidA-Extensive-Mesh" from="SolidA" />
    <receive-mesh name="SolidA-Intensive-Mesh" from="SolidA" />
    <receive-mesh name="SolidB-Mesh" from="SolidB" />
    <read-data name="Displacements" mesh="Fluid-SolidA-Intensive-Mesh" />
    <read-data name="Displacements" mesh="Fluid-SolidB-Mesh" />
    <write-data name="Forces" mesh="Fluid-SolidA-Extensive-Mesh" />
    <write-data name="Temperature" mesh="Fluid-SolidA-Intensive-Mesh" />
    <write-data name="Forces" mesh="Fluid-SolidB-Mesh" />
    <mapping:nearest-neighbor
      direction="write"
      from="Fluid-SolidA-Extensive-Mesh"
      to="SolidA-Extensive-Mesh"
      constraint="conservative" />
    <mapping:nearest-neighbor
      direction="read"
      from="SolidA-Intensive-Mesh"
      to="Fluid-SolidA-Intensive-Mesh"
      constraint="consistent" />
    <mapping:nearest-neighbor
      direction="write"
      from="Fluid-SolidB-Mesh"
      to="SolidB-Mesh"
      constraint="conservative" />
    <mapping:nearest-neighbor
      direction="read"
      from="SolidB-Mesh"
      to="Fluid-SolidB-Mesh"
      constraint="consistent" />
  </participant>

  <participant name="SolidA">
    <provide-mesh name="SolidA-Extensive-Mesh" />
    <provide-mesh name="SolidA-Intensive-Mesh" />
    <receive-mesh name="Fluid-SolidA-Intensive-Mesh" from="Fluid" />
    <read-data name="Forces" mesh="SolidA-Extensive-Mesh" />
    <read-data name="Temperature" mesh="SolidA-Intensive-Mesh" />
    <write-data name="Displacements" mesh="SolidA-Intensive-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid-SolidA-Intensive-Mesh"
      to="SolidA-Intensive-Mesh"
      constraint="consistent" />
  </participant>

  <participant name="SolidB">
    <provide-mesh name="SolidB-Mesh" />
    <read-data name="Forces" mesh="SolidB-Mesh" />
    <write-data name="Displacements" mesh="SolidB-Mesh" />
  </participant>

  <m2n:sockets acceptor="Fluid" connector="SolidA" exchange-directory=".." />
  <m2n:sockets acceptor="Fluid" connector="SolidB" exchange-directory=".." />

  <coupling-scheme:multi>
    <participant name="SolidB" />
    <participant name="Fluid" control="yes" />
    <participant name="SolidA" />
    <exchange data="Forces" mesh="SolidA-Extensive-Mesh" from="Fluid" to="SolidA" />
    <exchange data="Temperature" mesh="Fluid-SolidA-Intensive-Mesh" from="Fluid" to="SolidA" />
    <exchange data="Displacements" mesh="SolidA-Intensive-Mesh" from="SolidA" to="Fluid" />
    <exchange data="Forces" mesh="SolidB-Mesh" from="Fluid" to="SolidB" />
    <exchange data="Displacements" mesh="SolidB-Mesh" from="SolidB" to="Fluid" />
    <time-window-size value="0.1" />
    <max-time-windows value="10" />
    <relative-convergence-measure data="Forces" mesh="SolidA-Extensive-Mesh" limit="0.1" />
    <relative-convergence-measure
      data="Temperature"
      mesh="Fluid-SolidA-Intensive-Mesh"
      limit="0.1" />
    <relative-convergence-measure data="Displacements" mesh="SolidA-Intensive-Mesh" limit="0.1" />
    <relative-convergence-measure data="Forces" mesh="SolidB-Mesh" limit="0.1" />
    <relative-convergence-measure data="Displacements" mesh="SolidB-Mesh" limit="0.1" />
    <acceleration:IQN-ILS>
      <data name="Forces" mesh="SolidA-Extensive-Mesh" />
      <data name="Temperature" mesh="Fluid-SolidA-Intensive-Mesh" />
      <data name="Displacements" mesh="SolidA-Intensive-Mesh" />
      <data name="Forces" mesh="SolidB-Mesh" />
      <data name="Displacements" mesh="SolidB-Mesh" />
    </acceleration:IQN-ILS>
  </coupling-scheme:multi>
</precice-configuration>
